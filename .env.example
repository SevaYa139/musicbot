# --- Обязательное ---
BOT_TOKEN=
# Telegram ID администраторов через запятую (только цифры)
ADMIN_IDS=

# --- Инфраструктура (значения по умолчанию подходят для docker-compose) ---
DATABASE_URL=postgresql+asyncpg://musicbot:musicbot@postgres:5432/musicbot
REDIS_URL=redis://redis:6379/0

# --- Локальные ограничения и пути ---
TEMP_DIR=/tmp/musicbot
MAX_FILE_SIZE_MB=1900
MAX_VIDEO_DURATION_SECONDS=7200
MAX_CONCURRENT_JOBS=3
JOB_TIMEOUT_SECONDS=1800
RATE_LIMIT_PER_MINUTE=12
LOG_LEVEL=INFO

# --- Кастомные эмодзи из пакета (необязательно; id документов Telegram) ---
CUSTOM_EMOJI_MUSIC=
CUSTOM_EMOJI_VIDEO=
CUSTOM_EMOJI_DOWNLOAD=
CUSTOM_EMOJI_SEARCH=
CUSTOM_EMOJI_GEAR=
CUSTOM_EMOJI_UPLOAD=
CUSTOM_EMOJI_INBOX=
CUSTOM_EMOJI_CHECK=
CUSTOM_EMOJI_CROSS=
CUSTOM_EMOJI_CHART=
CUSTOM_EMOJI_LINK=
CUSTOM_EMOJI_PLAY=

# Прокси для yt-dlp (нужен TikTok, если IP сервера заблокирован): socks5://ip:port или http://ip:port
YTDLP_PROXY=

# --- Провайдеры ---
# Токен Spotify (client id/secret) — только метаданные, аудио не скачивается
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# OAuth-токен Яндекс Музыки (необязательно; без него — только метаданные публичных страниц)
YANDEX_TOKEN=
